# Credenciales reales del entorno (usar config/db.example.php como plantilla)
/config/db.php

# Dumps de base de datos: pueden tener datos reales de clientes,
# nunca deben viajar al repo ni quedar accesibles desde la web.
# El .htaccess sí se versiona -- es la traba que protege la carpeta
# si algún día vuelve a aparecer un dump ahí.
/sql/*
!/sql/.htaccess

# Lo mismo para db/: la regla de arriba cubría solo sql/, y apareció un
# volcado de producción en db/ (c2881399_polla.sql) con 46 hashes de
# contraseña, los clientes reales con su DNI y la tabla remember_tokens.
# Se ignora cualquier .sql suelto de db/ y se dejan pasar los scripts de
# instalación, que son plantillas sin datos reales. Las migraciones
# viven en db/migrations/, que esta regla no alcanza.
/db/*.sql
!/db/schema.sql
!/db/seed.sql

# Windows / macOS
Thumbs.db
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Logs y temporales
*.log
/tmp/
